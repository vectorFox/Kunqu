/**app.wxss**/
/* 昆曲美学风格全局样式 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}

page {
  background: #F5F0E8;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  font-family: 'PingFang SC', 'STKaiti', sans-serif;
  color: #2C5F5F;
}

/* 昆曲配色变量（供参考） */
/* 主色调：淡青 #B8D4D0, 米白 #F5F0E8, 黛蓝 #2C5F5F, 朱砂红 #C85554 */
/* 辅助色：青灰 #6B8E8E, 淡米色 #E8E0D0 */