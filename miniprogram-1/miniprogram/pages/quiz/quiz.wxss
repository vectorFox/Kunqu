/* pages/quiz/quiz.wxss */
page {
  height: 100%;
  background-color: #F5F0E8;
}

.quiz-container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 背景层 */
.background-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: linear-gradient(180deg, 
    rgba(245, 240, 232, 0.95) 0%,
    rgba(232, 224, 208, 0.9) 50%,
    rgba(184, 212, 208, 0.85) 100%);
}

/* 题目内容 */
.quiz-content {
  width: 100%;
  max-width: 700rpx;
  z-index: 1;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid #B8D4D0;
  box-sizing: border-box;
}

.quiz-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #B8D4D0;
}

.quiz-title {
  font-size: 40rpx;
  color: #2C5F5F;
  font-weight: bold;
  font-family: 'STKaiti', 'Kaiti SC', serif;
  letter-spacing: 4rpx;
}

/* 题目框 */
.question-box {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: rgba(184, 212, 208, 0.1);
  border-radius: 15rpx;
  border-left: 4rpx solid #B8D4D0;
  box-sizing: border-box;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
}

.question-text {
  font-size: 32rpx;
  line-height: 1.8;
  color: #2C5F5F;
  font-family: 'PingFang SC', 'STKaiti', sans-serif;
  letter-spacing: 2rpx;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* 选项容器 */
.options-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.option-item {
  width: 100%;
  padding: 30rpx 40rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 15rpx;
  border: 2rpx solid #B8D4D0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.option-item:active {
  transform: scale(0.98);
  background: rgba(184, 212, 208, 0.2);
}

.option-item.selected {
  background: rgba(184, 212, 208, 0.3);
  border-color: #6B8E8E;
  border-width: 3rpx;
  box-sizing: border-box;
}

.option-text {
  font-size: 28rpx;
  color: #2C5F5F;
  font-family: 'PingFang SC', sans-serif;
  line-height: 1.6;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* 结果显示 */
.result-box {
  width: 100%;
  text-align: center;
  box-sizing: border-box;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 30rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: bold;
}

.result-icon.correct {
  background: rgba(76, 175, 80, 0.2);
  color: #4CAF50;
  border: 3rpx solid #4CAF50;
}

.result-icon.incorrect {
  background: rgba(244, 67, 54, 0.2);
  color: #F44336;
  border: 3rpx solid #F44336;
}

.result-text {
  margin-bottom: 30rpx;
}

.result-message {
  font-size: 36rpx;
  font-weight: bold;
  font-family: 'PingFang SC', sans-serif;
}

.result-box .result-icon.correct ~ .result-text .result-message {
  color: #4CAF50;
}

.result-box .result-icon.incorrect ~ .result-text .result-message {
  color: #F44336;
}

/* 解析框 */
.explanation-box {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: rgba(184, 212, 208, 0.1);
  border-radius: 15rpx;
  text-align: left;
  box-sizing: border-box;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
}

.explanation-label {
  font-size: 28rpx;
  color: #6B8E8E;
  font-weight: bold;
  font-family: 'PingFang SC', sans-serif;
  display: block;
  margin-bottom: 15rpx;
}

.explanation-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #2C5F5F;
  font-family: 'PingFang SC', 'STKaiti', sans-serif;
  letter-spacing: 1rpx;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
}

/* 结果按钮 */
.result-buttons {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  flex-wrap: wrap;
  width: 100%;
  box-sizing: border-box;
}

.result-button {
  min-width: 180rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  flex-shrink: 0;
}

.result-button.primary {
  background: linear-gradient(135deg, #B8D4D0 0%, #8FB3AF 100%);
}

.result-button.secondary {
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid #B8D4D0;
}

.result-button text {
  font-size: 30rpx;
  color: #2C5F5F;
  font-weight: 500;
  font-family: 'PingFang SC', sans-serif;
}

.result-button.primary text {
  color: #FFFFFF;
}

