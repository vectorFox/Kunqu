<!--pages/quiz/quiz.wxml-->
<view class="quiz-container">
  <!-- 背景 -->
  <view class="background-layer"></view>

  <!-- 题目区域 -->
  <view class="quiz-content">
    <view class="quiz-header">
      <text class="quiz-title">知识考验</text>
    </view>

    <view class="question-box" wx:if="{{quiz}}">
      <text class="question-text">{{quiz.question}}</text>
    </view>

    <!-- 选项 -->
    <view class="options-container" wx:if="{{quiz && !showResult}}">
      <view class="option-item {{selectedIndex === index ? 'selected' : ''}}"
            wx:for="{{quiz.options}}"
            wx:key="index"
            wx:for-item="option"
            data-index="{{index}}"
            bindtap="onSelectAnswer">
        <text class="option-text">{{option}}</text>
      </view>
    </view>

    <!-- 结果显示 -->
    <view class="result-box" wx:if="{{showResult}}">
      <view class="result-icon {{isCorrect ? 'correct' : 'incorrect'}}">
        <text>{{isCorrect ? '✓' : '✗'}}</text>
      </view>
      <view class="result-text">
        <text class="result-message">{{isCorrect ? '回答正确！' : '回答错误'}}</text>
      </view>
      <view class="explanation-box">
        <text class="explanation-label">解析：</text>
        <text class="explanation-text">{{explanation}}</text>
      </view>
      <view class="result-buttons">
        <view class="result-button secondary" bindtap="onRetry" wx:if="{{!isCorrect}}">
          <text>重新答题</text>
        </view>
        <view class="result-button primary" bindtap="onContinue">
          <text>继续</text>
        </view>
      </view>
    </view>
  </view>
</view>

