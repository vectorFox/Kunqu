/* pages/archive/archive.wxss */
page {
  height: 100%;
  background-color: #F5F0E8;
}

.archive-container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

/* 背景层 */
.background-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: linear-gradient(180deg, 
    rgba(245, 240, 232, 0.95) 0%,
    rgba(232, 224, 208, 0.9) 50%,
    rgba(184, 212, 208, 0.85) 100%);
}

/* 标题区域 */
.header-section {
  z-index: 1;
  text-align: center;
  margin-bottom: 40rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid rgba(184, 212, 208, 0.3);
}

.header-title {
  margin-bottom: 15rpx;
}

.title-text {
  font-size: 48rpx;
  color: #2C5F5F;
  font-weight: bold;
  font-family: 'STKaiti', 'Kaiti SC', serif;
  letter-spacing: 6rpx;
}

.header-subtitle {
  margin-top: 10rpx;
}

.header-subtitle text {
  font-size: 24rpx;
  color: #6B8E8E;
  font-family: 'PingFang SC', sans-serif;
}

/* 统计信息 */
.stats-section {
  z-index: 1;
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
  padding: 30rpx 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-value {
  font-size: 40rpx;
  color: #2C5F5F;
  font-weight: bold;
  font-family: 'PingFang SC', sans-serif;
}

.stat-label {
  font-size: 24rpx;
  color: #6B8E8E;
  font-family: 'PingFang SC', sans-serif;
}

/* 档案列表 */
.archive-list {
  flex: 1;
  z-index: 1;
  width: 100%;
}

.archive-card {
  width: 100%;
  margin-bottom: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #B8D4D0;
  transition: all 0.3s ease;
}

.archive-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.card-title {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-name {
  font-size: 32rpx;
  color: #2C5F5F;
  font-weight: bold;
  font-family: 'PingFang SC', sans-serif;
}

.card-type {
  font-size: 24rpx;
  color: #6B8E8E;
  font-family: 'PingFang SC', sans-serif;
}

.card-content {
  margin-bottom: 20rpx;
}

.card-description {
  font-size: 26rpx;
  line-height: 1.8;
  color: #555555;
  font-family: 'PingFang SC', 'STKaiti', sans-serif;
  letter-spacing: 1rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.card-footer {
  padding-top: 15rpx;
  border-top: 1rpx solid rgba(184, 212, 208, 0.3);
}

.card-time {
  font-size: 22rpx;
  color: #999999;
  font-family: 'PingFang SC', sans-serif;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #999999;
  font-family: 'PingFang SC', sans-serif;
  margin-bottom: 20rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #CCCCCC;
  font-family: 'PingFang SC', sans-serif;
}

/* 返回按钮 */
.back-button {
  z-index: 1;
  width: 100%;
  height: 90rpx;
  margin-top: 30rpx;
  background: linear-gradient(135deg, #B8D4D0 0%, #8FB3AF 100%);
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.back-button text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
  font-family: 'PingFang SC', sans-serif;
}

