<!--pages/menu/menu.wxml-->
<view class="menu-container">
  <!-- 背景层 -->
  <view class="background-layer">
    <view class="stage-curtain"></view>
  </view>

  <!-- 标题 -->
  <view class="title-section">
    <text class="game-title">游园惊梦</text>
    <text class="game-subtitle">昆曲文化之旅</text>
  </view>

  <!-- 主按钮区 -->
  <view class="button-section">
    <view class="menu-button primary" bindtap="startGame">
      <text class="button-text">开始游戏</text>
    </view>
    
    <view class="menu-button {{hasProgress ? 'secondary' : 'disabled'}}" 
          bindtap="continueGame" 
          wx:if="{{hasProgress}}">
      <text class="button-text">继续游戏</text>
      <text class="button-hint">当前：{{currentChapter}}</text>
    </view>

    <view class="menu-button secondary" bindtap="goToArchive">
      <text class="button-text">学习档案</text>
    </view>

    <view class="menu-button secondary" bindtap="goToSettings">
      <text class="button-text">设置</text>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-text">昆曲文化传承 · 学术展示项目</text>
    <text class="footer-text version">v1.0.0</text>
  </view>
</view>

