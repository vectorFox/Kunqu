/* pages/menu/menu.wxss */
page {
  height: 100%;
  background: linear-gradient(180deg, #F5F0E8 0%, #E8E0D0 100%);
}

.menu-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  position: relative;
  padding: 80rpx 40rpx 60rpx;
  box-sizing: border-box;
}

/* 背景层 */
.background-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  overflow: hidden;
}

.stage-curtain {
  position: absolute;
  top: -20%;
  left: 0;
  width: 100%;
  height: 60%;
  background: linear-gradient(180deg, 
    rgba(184, 212, 208, 0.3) 0%,
    rgba(184, 212, 208, 0.1) 50%,
    transparent 100%);
  transform: rotate(-5deg);
  transform-origin: center;
}

/* 标题区域 */
.title-section {
  z-index: 1;
  text-align: center;
  margin-top: 60rpx;
  margin-bottom: 80rpx;
}

.game-title {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: #2C5F5F;
  font-family: 'STKaiti', 'Kaiti SC', serif;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx;
  letter-spacing: 8rpx;
}

.game-subtitle {
  display: block;
  font-size: 28rpx;
  color: #6B8E8E;
  font-family: 'PingFang SC', sans-serif;
  letter-spacing: 4rpx;
}

/* 按钮区域 */
.button-section {
  width: 100%;
  max-width: 600rpx;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.menu-button {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.menu-button.primary {
  background: linear-gradient(135deg, #B8D4D0 0%, #8FB3AF 100%);
  border: 2rpx solid #6B8E8E;
}

.menu-button.secondary {
  background: linear-gradient(135deg, #F5F0E8 0%, #E8E0D0 100%);
  border: 2rpx solid #B8D4D0;
}

.menu-button.disabled {
  opacity: 0.5;
  background: #E0E0E0;
  border-color: #CCCCCC;
}

.button-text {
  font-size: 32rpx;
  color: #2C5F5F;
  font-family: 'PingFang SC', sans-serif;
  font-weight: 500;
}

.menu-button.primary .button-text {
  color: #FFFFFF;
}

.button-hint {
  font-size: 22rpx;
  color: #6B8E8E;
  margin-top: 8rpx;
  font-family: 'PingFang SC', sans-serif;
}

/* 底部信息 */
.footer {
  z-index: 1;
  text-align: center;
  margin-top: 40rpx;
}

.footer-text {
  display: block;
  font-size: 22rpx;
  color: #999999;
  font-family: 'PingFang SC', sans-serif;
  margin-bottom: 10rpx;
}

.footer-text.version {
  font-size: 20rpx;
  color: #CCCCCC;
}

