<!--pages/admin/admin.wxml-->
<view class="admin-container">
  <!-- 背景 -->
  <view class="background-layer"></view>

  <!-- 标题 -->
  <view class="header-section">
    <text class="header-title">管理后台</text>
  </view>

  <!-- 统计信息 -->
  <view class="stats-section" wx:if="{{isAdmin}}">
    <view class="stat-item">
      <text class="stat-value">{{stats.totalUsers}}</text>
      <text class="stat-label">用户总数</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.totalQuiz}}</text>
      <text class="stat-label">题目总数</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.totalStory}}</text>
      <text class="stat-label">剧情节点</text>
    </view>
  </view>

  <!-- 管理功能 -->
  <view class="admin-functions" wx:if="{{isAdmin}}">
    <view class="function-item" bindtap="manageQuiz">
      <text class="function-icon">📝</text>
      <text class="function-text">题库管理</text>
      <text class="arrow-icon">›</text>
    </view>

    <view class="function-item" bindtap="manageStory">
      <text class="function-icon">📖</text>
      <text class="function-text">剧情管理</text>
      <text class="arrow-icon">›</text>
    </view>

    <view class="function-item" bindtap="viewUsers">
      <text class="function-icon">👥</text>
      <text class="function-text">用户数据</text>
      <text class="arrow-icon">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-button" wx:if="{{isAdmin}}" bindtap="logout">
    <text>退出登录</text>
  </view>
</view>
