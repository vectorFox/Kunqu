/* pages/admin/admin.wxss */
page {
  height: 100%;
  background-color: #F5F0E8;
}

.admin-container {
  width: 100%;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

/* 背景层 */
.background-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background: linear-gradient(180deg, 
    rgba(245, 240, 232, 0.95) 0%,
    rgba(232, 224, 208, 0.9) 50%,
    rgba(184, 212, 208, 0.85) 100%);
}

/* 标题区域 */
.header-section {
  z-index: 1;
  text-align: center;
  margin-bottom: 40rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid rgba(184, 212, 208, 0.3);
}

.header-title {
  font-size: 48rpx;
  color: #2C5F5F;
  font-weight: bold;
  font-family: 'STKaiti', 'Kaiti SC', serif;
  letter-spacing: 6rpx;
}

/* 统计信息 */
.stats-section {
  z-index: 1;
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
  padding: 30rpx 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-value {
  font-size: 40rpx;
  color: #2C5F5F;
  font-weight: bold;
  font-family: 'PingFang SC', sans-serif;
}

.stat-label {
  font-size: 24rpx;
  color: #6B8E8E;
  font-family: 'PingFang SC', sans-serif;
}

/* 管理功能 */
.admin-functions {
  flex: 1;
  z-index: 1;
  width: 100%;
}

.function-item {
  width: 100%;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(184, 212, 208, 0.3);
}

.function-item:active {
  background: rgba(184, 212, 208, 0.1);
}

.function-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.function-text {
  flex: 1;
  font-size: 30rpx;
  color: #2C5F5F;
  font-weight: 500;
  font-family: 'PingFang SC', sans-serif;
}

.arrow-icon {
  font-size: 40rpx;
  color: #999999;
}

/* 退出登录按钮 */
.logout-button {
  z-index: 1;
  width: 100%;
  height: 90rpx;
  margin-top: 30rpx;
  background: rgba(244, 67, 54, 0.9);
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.logout-button text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
  font-family: 'PingFang SC', sans-serif;
}
